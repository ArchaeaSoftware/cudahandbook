{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cudahandbook.com/benchmarks/schema-v1.json",
  "title": "CUDA Handbook benchmark submission",
  "type": "object",
  "required": [
    "schema",
    "date",
    "environment",
    "code",
    "results",
    "raw"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date the benchmarks were run (YYYY-MM-DD)"
    },
    "submitter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 80
        },
        "github": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]{1,39}$"
        }
      },
      "description": "Optional credit; shown on cudahandbook.com if present"
    },
    "environment": {
      "type": "object",
      "required": [
        "gpu",
        "cuda",
        "os"
      ],
      "additionalProperties": false,
      "properties": {
        "gpu": {
          "type": "object",
          "required": [
            "name",
            "sm",
            "driver"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 80
            },
            "sm": {
              "type": "string",
              "pattern": "^\\d{1,2}\\.\\d$",
              "description": "Compute capability, e.g. \"12.0\""
            },
            "vram_mib": {
              "type": "integer",
              "minimum": 128
            },
            "driver": {
              "type": "string",
              "maxLength": 20
            },
            "sm_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2048,
              "description": "Fingerprint (deviceProps): multiProcessorCount"
            },
            "clock_mhz": {
              "type": "integer",
              "minimum": 100,
              "maximum": 10000,
              "description": "Fingerprint (nvidia-smi): max SM clock"
            },
            "mem_clock_mhz": {
              "type": "integer",
              "minimum": 100,
              "maximum": 40000,
              "description": "Fingerprint (nvidia-smi): max memory clock"
            },
            "bus_width_bits": {
              "type": "integer",
              "minimum": 32,
              "maximum": 8192,
              "description": "Fingerprint (deviceProps): memoryBusWidth"
            },
            "l2_kib": {
              "type": "integer",
              "minimum": 16,
              "description": "Fingerprint (deviceProps): l2CacheSize in KiB"
            },
            "copy_engines": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64,
              "description": "Fingerprint (deviceProps): asyncEngineCount"
            },
            "pcie_gen": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7,
              "description": "Fingerprint (nvidia-smi): max PCIe link generation"
            },
            "pcie_width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32,
              "description": "Fingerprint (nvidia-smi): max PCIe link width (lanes)"
            }
          }
        },
        "cuda": {
          "type": "string",
          "maxLength": 20,
          "description": "CUDA toolkit version used to build"
        },
        "cpu": {
          "type": "object",
          "required": [
            "model"
          ],
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string",
              "maxLength": 120
            },
            "cores": {
              "type": "integer",
              "minimum": 1
            },
            "max_mhz": {
              "type": "integer",
              "minimum": 100
            }
          }
        },
        "ram_gib": {
          "type": "integer",
          "minimum": 1
        },
        "platform": {
          "type": "string",
          "maxLength": 80,
          "description": "\"bare-metal\", \"aws g6e.xlarge\", \"wsl2\", ..."
        },
        "os": {
          "type": "string",
          "maxLength": 80
        },
        "gpu_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "code": {
      "type": "object",
      "required": [
        "commit",
        "dirty"
      ],
      "additionalProperties": false,
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "dirty": {
          "type": "boolean"
        }
      }
    },
    "results": {
      "type": "object",
      "minProperties": 1,
      "description": "Metric key -> measurement. Keys are the contract with bench/metrics.json.",
      "patternProperties": {
        "^[a-z0-9]+(?:[.-][a-z0-9]+)*$": {
          "type": "object",
          "required": [
            "unit"
          ],
          "additionalProperties": false,
          "properties": {
            "unit": {
              "type": "string",
              "maxLength": 20
            },
            "value": {
              "type": "number"
            },
            "series": {
              "type": "object",
              "minProperties": 1,
              "patternProperties": {
                "^-?\\d+(?:\\.\\d+)?$": {
                  "type": "number"
                }
              },
              "additionalProperties": false,
              "description": "Sweep results keyed by the swept parameter value"
            }
          },
          "oneOf": [
            {
              "required": [
                "value"
              ]
            },
            {
              "required": [
                "series"
              ]
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "raw": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+\\.raw\\.txt$",
      "description": "Sibling file containing the verbatim program output"
    }
  }
}
